-- Clipboard configuration: Local clipboard, shared file cache, and OSC 52
if pcall(require, 'vim.ui.clipboard.osc52') then
  local osc52 = require('vim.ui.clipboard.osc52')

  local clip_dir = vim.fn.expand(vim.env.XDG_CACHE_HOME and vim.env.XDG_CACHE_HOME ~= '' and vim.env.XDG_CACHE_HOME or '~/.cache')
  local clip_file = clip_dir .. '/clipboard'

  local function write_clip_cache(lines)
    if vim.fn.isdirectory(clip_dir) == 0 then
      vim.fn.mkdir(clip_dir, 'p')
    end
    local f = io.open(clip_file, 'w')
    if f then
      if type(lines) == 'table' then
        f:write(table.concat(lines, '\n'))
      else
        f:write(tostring(lines))
      end
      f:close()
    end
  end

  local function resolve_client_env()
    local env_dir = vim.fn.expand(vim.env.XDG_RUNTIME_DIR and (vim.env.XDG_RUNTIME_DIR .. '/zellij-env') or '/tmp/zellij-env')
    local session = vim.env.ZELLIJ_SESSION_NAME
    local env_file = env_dir .. '/' .. (session and session ~= '' and session or 'client')
    local f = io.open(env_file, 'r')
    if not f and session and session ~= '' then
      f = io.open(env_dir .. '/client', 'r')
    end

    local is_ssh = false
    local wayland = vim.env.WAYLAND_DISPLAY
    local display = vim.env.DISPLAY

    if f then
      local content = f:read('*a')
      f:close()
      if content then
        local ssh_flag = content:match('SSH=([^\n]+)')
        local auth_sock = content:match('SSH_AUTH_SOCK=([^\n]*)')
        local ssh_client = content:match('SSH_CLIENT=([^\n]*)')
        local ssh_conn = content:match('SSH_CONNECTION=([^\n]*)')
        local ssh_tty = content:match('SSH_TTY=([^\n]*)')

        if auth_sock and auth_sock ~= '' then
          vim.env.SSH_AUTH_SOCK = auth_sock
        elseif auth_sock == '' then
          vim.env.SSH_AUTH_SOCK = nil
        end
        if ssh_client and ssh_client ~= '' then vim.env.SSH_CLIENT = ssh_client else vim.env.SSH_CLIENT = nil end
        if ssh_conn and ssh_conn ~= '' then vim.env.SSH_CONNECTION = ssh_conn else vim.env.SSH_CONNECTION = nil end
        if ssh_tty and ssh_tty ~= '' then vim.env.SSH_TTY = ssh_tty else vim.env.SSH_TTY = nil end

        if ssh_flag == '1' then
          is_ssh = true
          wayland = nil
          display = nil
        else
          local w = content:match('WAYLAND_DISPLAY=([^\n]*)')
          local d = content:match('DISPLAY=([^\n]*)')
          if w and w ~= '' then wayland = w end
          if d and d ~= '' then display = d end
        end
      end
    elseif vim.env.SSH_CONNECTION or vim.env.SSH_CLIENT or vim.env.SSH_TTY then
      is_ssh = true
      wayland = nil
      display = nil
    end

    return is_ssh, wayland, display
  end

  local function local_copy(lines, regtype)
    local is_ssh, wayland, display = resolve_client_env()

    if not is_ssh then
      local copy_cmd = nil
      local env = nil
      if wayland and wayland ~= '' and vim.fn.executable('wl-copy') == 1 then
        copy_cmd = { 'wl-copy' }
        env = { WAYLAND_DISPLAY = wayland }
      elseif vim.fn.executable('pbcopy') == 1 then
        copy_cmd = { 'pbcopy' }
      elseif display and display ~= '' and vim.fn.executable('xclip') == 1 then
        copy_cmd = { 'xclip', '-selection', 'clipboard' }
        env = { DISPLAY = display }
      end

      if copy_cmd then
        local text = type(lines) == 'table' and table.concat(lines, '\n') or tostring(lines)
        vim.system(copy_cmd, { stdin = text, stdout = false, stderr = false, env = env })
      end
    end

    write_clip_cache(lines)
    osc52.copy('+')(lines)
  end

  local function local_paste()
    local is_ssh, wayland, display = resolve_client_env()

    if not is_ssh then
      local paste_cmd = nil
      local env = nil
      if wayland and wayland ~= '' and vim.fn.executable('wl-paste') == 1 then
        paste_cmd = { 'wl-paste', '--no-newline' }
        env = { WAYLAND_DISPLAY = wayland }
      elseif vim.fn.executable('pbpaste') == 1 then
        paste_cmd = { 'pbpaste' }
      elseif display and display ~= '' and vim.fn.executable('xclip') == 1 then
        paste_cmd = { 'xclip', '-selection', 'clipboard', '-o' }
        env = { DISPLAY = display }
      end

      if paste_cmd then
        local out = nil
        if env then
          local obj = vim.system(paste_cmd, { env = env, text = true }):wait()
          if obj.code == 0 and obj.stdout and #obj.stdout > 0 then
            out = vim.fn.split(obj.stdout, '\n')
          end
        else
          local list = vim.fn.systemlist(paste_cmd)
          if vim.v.shell_error == 0 and #list > 0 then
            out = list
          end
        end
        if out and #out > 0 then
          local regtype = vim.fn.getregtype('+')
          return { out, regtype ~= '' and regtype or 'v' }
        end
      end
    end

    local f = io.open(clip_file, 'r')
    if f then
      local content = f:read('*a')
      f:close()
      if content and #content > 0 then
        local lines = vim.fn.split(content, '\n', 1)
        local regtype = vim.fn.getregtype('+')
        return { lines, regtype ~= '' and regtype or 'v' }
      end
    end
    local unnamed = vim.fn.getreg('"')
    local regtype = vim.fn.getregtype('"')
    return { vim.fn.split(unnamed, '\n'), regtype ~= '' and regtype or 'v' }
  end

  vim.g.clipboard = {
    name = 'Local & OSC 52 Clipboard',
    copy = {
      ['+'] = local_copy,
      ['*'] = local_copy,
    },
    paste = {
      ['+'] = local_paste,
      ['*'] = local_paste,
    },
  }
end

