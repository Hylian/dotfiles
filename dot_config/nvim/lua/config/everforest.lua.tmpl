{{- $csName := get . "colorscheme" | default (get .host_colorschemes .chezmoi.hostname) | default .default_colorscheme -}}
{{- $cs := get .colorschemes $csName -}}
{{- $p := $cs.palette -}}
require("everforest").setup({
  -- Controls the "hardness" of the background. Options are "soft", "medium" or "hard".
  -- Default is "medium".
  background = "hard",
  -- How much of the background should be transparent. Options are 0, 1 or 2.
  -- Default is 0.
  --
  -- 2 will have more UI components be transparent (e.g. status line
  -- background).
  transparent_background_level = 2,
  -- Whether italics should be used for keywords, builtin types and more.
  italics = false,
  -- Disable italic fonts for comments. Comments are in italics by default, set
  -- this to `true` to make them _not_ italic!
  disable_italic_comments = true,
  ui_contrast = "medium",
  colours_override = function(palette)
{{- if and (ne $cs.name "everforest-light") (ne $cs.name "everforest-dark") }}
    palette.bg_dim = "{{ $p.bg0 }}"
    palette.bg0 = "{{ $p.bg0 }}"
    palette.bg1 = "{{ $p.bg1 }}"
    palette.bg2 = "{{ $p.bg2 }}"
    palette.bg3 = "{{ $p.bg3 }}"
    palette.bg4 = "{{ $p.bg4 }}"
    palette.bg5 = "{{ $p.grey2 }}"
    palette.bg_visual = "{{ $p.bg_visual }}"
    palette.bg_red = "{{ $p.bg_red }}"
    palette.bg_green = "{{ $p.diff_add }}"
    palette.bg_blue = "{{ $p.bg_blue }}"
    palette.bg_yellow = "{{ $p.bg_yellow }}"
    palette.bg_purple = "{{ $p.bg_red }}"
    palette.fg = "{{ $p.fg }}"
    palette.red = "{{ $p.red }}"
    palette.orange = "{{ $p.orange }}"
    palette.yellow = "{{ $p.yellow }}"
    palette.green = "{{ $p.green }}"
    palette.aqua = "{{ $p.aqua }}"
    palette.blue = "{{ $p.blue }}"
    palette.purple = "{{ $p.purple }}"
    palette.grey0 = "{{ $p.grey0 }}"
    palette.grey1 = "{{ $p.grey1 }}"
    palette.grey2 = "{{ $p.grey2 }}"
    palette.statusline1 = "{{ $p.green }}"
    palette.statusline2 = "{{ $p.fg }}"
    palette.statusline3 = "{{ $p.red }}"
{{- else }}
    --palette.fg = "#4b575e"
    --palette.bg0 = "#fffbef"
    --palette.bg1_medium = "#f4f0d9"
    --if os.getenv("SSH_TTY") == nil then
      --palette.bg0 = "#ffffff"
      --palette.fg = "#677666"
    --else
      --palette.bg0 = "#fffbef"
      --pallete.fg = "#1a1e20"
    --end
{{- end }}
  end,
  on_highlights = function(hl, palette)
    hl.TabLineFill = { fg = palette.none, bg = palette.bg1, sp = palette.red }
    hl.TabLineSep = { fg = palette.bg1, bg = palette.none, sp = palette.red }
    hl.TabLineTabSep = { fg = palette.bg1, bg = palette.bg1, sp = palette.red }
    hl.TabLineInactiveSep = { fg = palette.blue, bg = palette.bg1, sp = palette.red }
    hl.TabLineInactive = { fg = palette.fg, bg = palette.bg4, sp = palette.red }
    hl.TabLineCurrent = { fg = palette.green, bg = palette.none, sp = palette.red }

    -- Delta-style diff highlights that preserve Treesitter syntax foregrounds
    hl.DiffAdd = { fg = palette.none, bg = "{{ $p.diff_add }}" }
    hl.DiffDelete = { fg = palette.none, bg = "{{ $p.diff_del }}" }
    hl.DiffChange = { fg = palette.none, bg = palette.bg_blue }
    hl.DiffText = { fg = palette.none, bg = "{{ $p.diff_add_emph }}" }
    hl.DiffTextAdd = { fg = palette.none, bg = "{{ $p.diff_add_emph }}" }
    hl.DiffviewDiffAdd = { fg = palette.none, bg = "{{ $p.diff_add }}" }
    hl.DiffviewDiffAddAsDelete = { fg = palette.none, bg = "{{ $p.diff_del }}" }
    hl.DiffviewDiffDelete = { fg = "{{ $p.grey2 }}", bg = palette.none }
    hl.DiffviewDiffDeleteDim = { fg = "{{ $p.grey2 }}", bg = palette.none }
    hl.DiffviewDiffChangeDelete = { fg = palette.none, bg = "{{ $p.diff_del }}" }
    hl.DiffviewDiffTextDelete = { fg = palette.none, bg = "{{ $p.diff_del_emph }}" }
    hl.DiffviewDiffChangeAdd = { fg = palette.none, bg = "{{ $p.diff_add }}" }
    hl.DiffviewDiffTextAdd = { fg = palette.none, bg = "{{ $p.diff_add_emph }}" }
  end,
})

require('everforest').load()
