{{- $csName := get . "colorscheme" | default (get .host_colorschemes .chezmoi.hostname) | default .default_colorscheme -}}
{{- $cs := get .colorschemes $csName -}}
{{- $p := $cs.palette -}}
{{- /* A locally built zjstatus is assumed to carry the patch that repaints on a
       command result change; ZJSTATUS_AUTORENDER tells the git widget to skip its
       own repaint kick. Hosts without a local build fall back to the release. */ -}}
{{- $zjstatus := printf "%s/.config/zellij/plugins/zjstatus.wasm" .chezmoi.homeDir -}}
{{- $patched := stat $zjstatus -}}
layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="{{ if $patched }}file:{{ $zjstatus }}{{ else }}https://github.com/dj95/zjstatus/releases/latest/download/zjstatus.wasm{{ end }}" {
                format_left   "{mode} {tabs}"
                format_right  "#[fg={{ $p.purple | upper }},bg={{ $p.bg_bar | upper }}]#[bg={{ $p.purple | upper }},fg={{ $p.fg_reverse | upper }}]  {command_git_branch} #[fg={{ $p.blue | upper }},bg={{ $p.purple | upper }}]#[bg={{ $p.blue | upper }},fg={{ $p.fg_reverse | upper }}] {session} #[fg={{ $p.green | upper }},bg={{ $p.blue | upper }}]#[bg={{ $p.green | upper }},fg={{ $p.fg_reverse | upper }}] {{ .chezmoi.fqdnHostname }}{command_host} #[fg={{ $p.green | upper }}]"
                format_space  "#[fg={{ $p.green | upper }},bg={{ $p.bg_bar | upper }}]"

                border_enabled  "false"

                hide_frame_for_single_pane "false"

                format_hide_on_overlength "true"
                format_precedence "lrc"

                mode_normal        "#[fg={{ $p.green | upper }}]#[bg={{ $p.green | upper }},fg={{ $p.fg_reverse | upper }}] NORMAL #[fg={{ $p.green | upper }},bg={{ $p.bg_bar | upper }}]"
                mode_locked        "#[fg={{ $p.red | upper }}]#[bg={{ $p.red | upper }},fg={{ $p.fg_reverse | upper }}] LOCKED #[fg={{ $p.red | upper }},bg={{ $p.bg_bar | upper }}]"
                mode_resize        "#[fg={{ $p.green | upper }}]#[bg={{ $p.green | upper }},fg={{ $p.fg_reverse | upper }}] RESIZE #[fg={{ $p.green | upper }},bg={{ $p.bg_bar | upper }}]"
                mode_pane          "#[fg={{ $p.green | upper }}]#[bg={{ $p.green | upper }},fg={{ $p.fg_reverse | upper }}]  PANE  #[fg={{ $p.green | upper }},bg={{ $p.bg_bar | upper }}]"
                mode_tab           "#[fg={{ $p.green | upper }}]#[bg={{ $p.green | upper }},fg={{ $p.fg_reverse | upper }}]  TAB   #[fg={{ $p.green | upper }},bg={{ $p.bg_bar | upper }}]"
                mode_scroll        "#[fg={{ $p.green | upper }}]#[bg={{ $p.green | upper }},fg={{ $p.fg_reverse | upper }}] SCROLL #[fg={{ $p.green | upper }},bg={{ $p.bg_bar | upper }}]"
                mode_enter_search  "#[fg={{ $p.green | upper }}]#[bg={{ $p.green | upper }},fg={{ $p.fg_reverse | upper }}] SEARCH #[fg={{ $p.green | upper }},bg={{ $p.bg_bar | upper }}]"
                mode_search        "#[fg={{ $p.green | upper }}]#[bg={{ $p.green | upper }},fg={{ $p.fg_reverse | upper }}] SEARCH #[fg={{ $p.green | upper }},bg={{ $p.bg_bar | upper }}]"
                mode_rename_tab    "#[fg={{ $p.green | upper }}]#[bg={{ $p.green | upper }},fg={{ $p.fg_reverse | upper }}] RENAME #[fg={{ $p.green | upper }},bg={{ $p.bg_bar | upper }}]"
                mode_rename_pane   "#[fg={{ $p.green | upper }}]#[bg={{ $p.green | upper }},fg={{ $p.fg_reverse | upper }}] RENAME #[fg={{ $p.green | upper }},bg={{ $p.bg_bar | upper }}]"
                mode_session       "#[fg={{ $p.green | upper }}]#[bg={{ $p.green | upper }},fg={{ $p.fg_reverse | upper }}] SESSN  #[fg={{ $p.green | upper }},bg={{ $p.bg_bar | upper }}]"
                mode_move          "#[fg={{ $p.green | upper }}]#[bg={{ $p.green | upper }},fg={{ $p.fg_reverse | upper }}] MOVE   #[fg={{ $p.green | upper }},bg={{ $p.bg_bar | upper }}]"
                mode_prompt        "#[fg={{ $p.green | upper }}]#[bg={{ $p.green | upper }},fg={{ $p.fg_reverse | upper }}] PROMPT #[fg={{ $p.green | upper }},bg={{ $p.bg_bar | upper }}]"

                tab_normal   "#[fg={{ $p.bg1 | upper }},bg={{ $p.bg_bar | upper }}]#[bg={{ $p.bg1 | upper }},fg={{ $p.grey2 | upper }}] {name} #[fg={{ $p.bg1 | upper }},bg={{ $p.bg_bar | upper }}]#[fg={{ $p.bg1 | upper }},bg={{ $p.bg_bar | upper }}] "
                tab_active   "#[fg={{ $p.bg_bar | upper }},bg={{ $p.tab_active_bg | upper }}]#[fg={{ $p.tab_active_fg | upper }},bg={{ $p.tab_active_bg | upper }}] {name} #[fg={{ $p.bg_bar | upper }},bg={{ $p.tab_active_bg | upper }}]#[fg={{ $p.tab_active_bg | upper }},bg={{ $p.bg_bar | upper }}] "

                command_git_branch_command    "{{ .chezmoi.homeDir }}/.config/zellij/widgets/git-status.sh"
                command_git_branch_format     "{stdout}"
                command_git_branch_rendermode "static"
                command_git_branch_interval   "5"
                command_git_branch_cwd        "{focused_pane_cwd}"
{{- if $patched }}
                command_git_branch_env        "ZJSTATUS_AUTORENDER \"1\""
{{- end }}

                command_host_command    "{{ .chezmoi.homeDir }}/.config/zellij/widgets/host-status.sh"
                command_host_format     "{stdout}"
                command_host_rendermode "static"
                command_host_interval   "2"

                datetime        "#[fg={{ $p.fg_reverse | upper }},bold] {format} "
                datetime_format "%A, %d %b %Y %H:%M"
                datetime_timezone "America/New_York"
            }
        }
        children
    }
}
