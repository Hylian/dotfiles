#!/bin/sh

env_dir="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/zellij-env"
session="${ZELLIJ_SESSION_NAME:-client}"

env_file="$env_dir/$session"
if [ ! -f "$env_file" ] || { [ -f "$env_dir/client" ] && [ "$env_dir/client" -nt "$env_file" ]; }; then
	env_file="$env_dir/client"
fi

is_ssh=0
if [ -f "$env_file" ]; then
	while IFS='=' read -r k v; do
		if [ "$k" = "SSH" ]; then
			is_ssh="$v"
			break
		fi
	done < "$env_file"
elif [ -n "$SSH_CONNECTION" ] || [ -n "$SSH_CLIENT" ] || [ -n "$SSH_TTY" ]; then
	is_ssh=1
fi

if [ "$is_ssh" = "1" ]; then
	printf ' 🌐\n'
fi
