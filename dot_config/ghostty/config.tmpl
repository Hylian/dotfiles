{{- $csName := get . "colorscheme" | default (get .host_colorschemes .chezmoi.hostname) | default .default_colorscheme -}}
{{- $cs := get .colorschemes $csName -}}
{{- $p := $cs.palette -}}
# Fonts

font-family = PragmataPro Mono
font-family-bold = PragmataPro Mono
font-family-italic = PragmataPro Mono
font-family-bold-italic = PragmataPro Mono
font-synthetic-style = true
{{ if eq .chezmoi.hostname "eterna" }}
font-size = 16
{{ else if eq .chezmoi.hostname "shined" -}}
font-size = 15
{{ else }}
font-size = 18
{{ end }}

# Colors
background = {{ trimPrefix "#" $p.bg0 }}
foreground = {{ trimPrefix "#" $p.fg }}

palette =  0={{ get $p "ansi_black" | default $p.grey0 }}
palette =  1={{ $p.red }}
palette =  2={{ $p.green }}
palette =  3={{ $p.yellow }}
palette =  4={{ $p.blue }}
palette =  5={{ $p.purple }}
palette =  6={{ $p.aqua }}
palette =  7={{ get $p "ansi_white" | default $p.bg2 }}
palette =  8={{ $p.br_black }}
palette =  9={{ $p.br_red }}
palette = 10={{ $p.br_green }}
palette = 11={{ $p.br_yellow }}
palette = 12={{ $p.br_blue }}
palette = 13={{ $p.br_purple }}
palette = 14={{ $p.br_aqua }}
palette = 15={{ $p.br_white }}

selection-foreground = {{ trimPrefix "#" ($p.sel_fg | upper) }}
selection-background = {{ trimPrefix "#" ($p.sel_bg | upper) }}

# Layout
{{ if eq .chezmoi.hostname "shined" -}}
window-padding-x = 2
window-padding-y = 1
{{- else -}}
window-padding-x = 6
window-padding-y = 8
{{- end }}

window-padding-balance = true
resize-overlay = never

# Cursor
cursor-click-to-move = true
mouse-hide-while-typing = true
{{ if eq .chezmoi.os "darwin" -}}
mouse-scroll-multiplier = precision:0.33333,discrete:1
{{- else -}}
mouse-scroll-multiplier = 0.33333
{{- end }}

# Fancy
background-opacity = 1.0
{{ if eq .chezmoi.os "darwin" -}}
window-decoration = true
{{- else -}}
window-decoration = false
{{- end }}

# Settings
shell-integration-features=true
confirm-close-surface = false
clipboard-read = allow
link-url = true
grapheme-width-method = unicode
clipboard-trim-trailing-spaces = true
clipboard-paste-protection = true
app-notifications = false
macos-titlebar-style = hidden
macos-option-as-alt = true

# Perf
{{ if ne .chezmoi.os "darwin" -}}
quit-after-last-window-closed = false
quit-after-last-window-closed-delay = 10m
{{- else -}}
quit-after-last-window-closed = true
{{- end }}
window-save-state = never
gtk-single-instance = false

# Bindings
keybind = alt+1=unbind
keybind = alt+2=unbind
keybind = alt+3=unbind
keybind = alt+4=unbind
keybind = alt+5=unbind
keybind = alt+6=unbind
keybind = alt+7=unbind
keybind = alt+8=unbind
keybind = alt+9=unbind
keybind = alt+0=unbind
keybind = alt+left=unbind
keybind = alt+right=unbind
keybind = alt+up=unbind
keybind = alt+down=unbind
keybind = alt+control+left=unbind
keybind = alt+control+right=unbind
keybind = alt+left_bracket=unbind
keybind = alt+right_bracket=unbind
keybind = alt+shift+left_bracket=unbind
keybind = alt+shift+right_bracket=unbind
keybind = super+d=quit

{{ if eq .chezmoi.os "darwin" }}
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = super+c=copy_to_clipboard
keybind = super+v=paste_from_clipboard
{{ end }}
