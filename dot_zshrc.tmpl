# Tell Zellij the pane's cwd synchronously, so zjstatus can invalidate its
# focused-cwd widgets the instant we switch panes instead of waiting for the
# server's background cwd poll. Pure parameter expansion: no subprocess.
_zellij_osc7_cwd() {
    printf '\e]7;file://%s\a' "${PWD// /%20}"
}

zellij_tab_name_update() {
    local current_dir=$PWD
    if [[ $current_dir == $HOME ]]; then
        current_dir="~"
    else
        current_dir=${current_dir##*/}
    fi
    command zellij action rename-tab "$current_dir" </dev/null >/dev/null 2>&1 &!
}

# The zjstatus git widget keeps two caches: a one-slot memo of its last rendered
# output, which absorbs the burst of re-spawns zjstatus fires per pane switch, and
# a per-repository memo of the O(worktree) dirty check. Dropping both makes the
# next widget run recompute from scratch, so our own commands and directory
# changes reach the bar at once and the widget's TTLs only have to cover changes
# made outside this shell. The repo path is resolved on chpwd so the per-prompt
# hook stays fork-free.
_zellij_git_memo=${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/zjstatus-git-memo.${ZELLIJ_SESSION_NAME:-nosession}
_zellij_git_dirty_cache=''
_zellij_git_dirty_checked=0

_zellij_track_git_dirty_cache() {
    local gitdir
    if gitdir=$(command git --no-optional-locks rev-parse --absolute-git-dir 2>/dev/null); then
        _zellij_git_dirty_cache="$gitdir/zjstatus-dirty"
    else
        _zellij_git_dirty_cache=''
    fi
    _zellij_git_dirty_checked=1
}

# Sole definition: the fzf widgets in ~/.config/zsh/widgets call this directly, so
# it carries its own guard rather than relying on the registration below.
_zellij_refresh_git_branch() {
    [[ -n $ZELLIJ ]] && (( $+commands[zellij] )) || return 0
    if (( ! _zellij_git_dirty_checked )); then
        _zellij_track_git_dirty_cache
    fi
    zf_rm -f -- "$_zellij_git_memo"
    [[ -n $_zellij_git_dirty_cache ]] && zf_rm -f -- "$_zellij_git_dirty_cache"
    command zellij pipe "zjstatus::rerun::git_branch" </dev/null >/dev/null 2>&1 &!
}

if [[ -n $ZELLIJ ]]; then
    zmodload -F zsh/files b:zf_rm
    zmodload -F zsh/stat b:zstat 2>/dev/null
    _zellij_sync_client_env_hook
    chpwd_functions+=(zellij_tab_name_update _zellij_track_git_dirty_cache)
    precmd_functions+=(_zellij_sync_client_env_hook _zellij_osc7_cwd _zellij_refresh_git_branch)
fi


