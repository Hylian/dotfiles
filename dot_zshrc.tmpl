# Cached Tool Initializations
if (( $+commands[zellij] )); then
  _zellij_sync_client_env() {
    case "$1" in
      action|edit|run|setup|plugin|list-sessions|delete-session|delete-all-sessions|kill-all-sessions|convert-*|options|pipe)
        return 0
        ;;
    esac

    local session=""
    local prev=""
    for arg in "$@"; do
      if [[ "$prev" == "-s" || "$prev" == "--session" || "$prev" == "attach" || "$prev" == "a" || "$prev" == "-c" || "$prev" == "--create" ]]; then
        if [[ "$arg" != -* ]]; then
          session="$arg"
          break
        fi
      fi
      if [[ "$arg" == "-s" || "$arg" == "--session" || "$arg" == "attach" || "$arg" == "a" || "$arg" == "-c" || "$arg" == "--create" ]]; then
        prev="$arg"
      elif [[ "$arg" != -* && -z "$prev" ]]; then
        session="$arg"
        break
      fi
    done
    session="${session:-${ZELLIJ_SESSION_NAME:-}}"

    local env_dir="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/zellij-env"
    mkdir -p "$env_dir" 2>/dev/null
    local content
    if [[ -n "$SSH_CONNECTION" || -n "$SSH_CLIENT" || -n "$SSH_TTY" ]]; then
      content="SSH=1\nSSH_AUTH_SOCK=${SSH_AUTH_SOCK:-}\nSSH_CLIENT=${SSH_CLIENT:-}\nSSH_CONNECTION=${SSH_CONNECTION:-}\nSSH_TTY=${SSH_TTY:-}\nWAYLAND_DISPLAY=\nDISPLAY=\n"
    else
      content="SSH=0\nSSH_AUTH_SOCK=${SSH_AUTH_SOCK:-}\nSSH_CLIENT=\nSSH_CONNECTION=\nSSH_TTY=\nWAYLAND_DISPLAY=${WAYLAND_DISPLAY:-}\nDISPLAY=${DISPLAY:-}\n"
    fi
    if [[ -n "$session" ]]; then
      printf "%b" "$content" > "$env_dir/$session" 2>/dev/null
    fi
    printf "%b" "$content" > "$env_dir/client" 2>/dev/null

    if [[ -n "$SSH_AUTH_SOCK" ]]; then
      ln -snf "$SSH_AUTH_SOCK" "$env_dir/ssh-auth-sock" 2>/dev/null
    elif [[ -e "$env_dir/ssh-auth-sock" ]]; then
      rm -f "$env_dir/ssh-auth-sock" 2>/dev/null
    fi
  }

  zellij() {
    _zellij_sync_client_env "$@"
    command zellij "$@"
  }

  if [[ -z "$ZELLIJ" ]]; then
    _zellij_sync_client_env
  fi

  if [[ ! -f "$ZSH_CACHE_DIR/zellij.zsh" || "$commands[zellij]" -nt "$ZSH_CACHE_DIR/zellij.zsh" ]]; then
    zellij setup --generate-auto-start zsh >! "$ZSH_CACHE_DIR/zellij.zsh" 2>/dev/null
    zcompile "$ZSH_CACHE_DIR/zellij.zsh" 2>/dev/null
  fi
  source "$ZSH_CACHE_DIR/zellij.zsh"
fi

if (( $+commands[zoxide] )); then
