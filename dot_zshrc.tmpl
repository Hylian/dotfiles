# Setup Zsh Initialization Cache
ZSH_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/zsh"
[[ -d "$ZSH_CACHE_DIR" ]] || mkdir -p "$ZSH_CACHE_DIR"

# Zsh Completion Caching
ZSH_DISABLE_COMPFIX="true"
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "$ZSH_CACHE_DIR/zcompcache"

# History Configuration
HISTFILE="${HISTFILE:-$HOME/.zsh_history}"
HISTSIZE=50000
SAVEHIST=50000

setopt EXTENDED_HISTORY          # Write timestamp and elapsed time to history file
setopt SHARE_HISTORY             # Share history between all active sessions in real time
setopt HIST_EXPIRE_DUPS_FIRST    # Expire duplicate entries first when trimming history
setopt HIST_IGNORE_DUPS          # Do not record an entry that was just recorded
setopt HIST_IGNORE_ALL_DUPS      # Delete old recorded entry if new entry is a duplicate
setopt HIST_FIND_NO_DUPS         # Do not display a line previously found
setopt HIST_IGNORE_SPACE         # Do not record an entry starting with a space
setopt HIST_SAVE_NO_DUPS         # Do not write duplicate entries in the history file
setopt HIST_REDUCE_BLANKS        # Remove superfluous blanks before recording entry
setopt HIST_VERIFY               # Do not execute immediately upon history expansion
unsetopt BEEP                    # Never ring the bell on ZLE syntax errors or escape sequences

# Read history from disk into memory immediately upon startup
[[ -f "$HISTFILE" ]] && fc -R "$HISTFILE" 2>/dev/null

# Setup Antigen
ANTIGEN_PATH_DEBIAN=/usr/share/zsh-antigen/antigen.zsh
ANTIGEN_PATH_ARCH=/usr/share/zsh/share/antigen.zsh
ANTIGEN_PATH_MAC=/opt/homebrew/share/antigen/antigen.zsh
has_antigen=false

if [[ "$OSTYPE" == "darwin"* && -f "$ANTIGEN_PATH_MAC" ]]; then
  source "$ANTIGEN_PATH_MAC"
  has_antigen=true
elif [[ -f "$ANTIGEN_PATH_ARCH" ]]; then
  source "$ANTIGEN_PATH_ARCH"
  has_antigen=true
elif [[ -f "$ANTIGEN_PATH_DEBIAN" ]]; then
  source "$ANTIGEN_PATH_DEBIAN"
  has_antigen=true
fi

if [[ "$has_antigen" == true ]]; then
  antigen use oh-my-zsh

  antigen bundle direnv
  antigen bundle fd
  antigen bundle pip
  antigen bundle ripgrep
  antigen bundle jeffreytse/zsh-vi-mode
  antigen bundle zsh-users/zsh-autosuggestions
  antigen bundle fzf

  antigen apply
fi

DISABLE_UNTRACKED_FILES_DIRTY="true"
VI_MODE_RESET_PROMPT_ON_MODE_CHANGE=true
VI_MODE_SET_CURSOR=true

typeset -g _zellij_client_env_mtime=0
_ZSH_CLIP_IS_SSH=0
_ZSH_CLIP_WAYLAND="$WAYLAND_DISPLAY"
_ZSH_CLIP_DISPLAY="$DISPLAY"

_zellij_sync_client_env_hook() {
  [[ -n "$ZELLIJ" ]] || return 0
  local env_dir="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/zellij-env"
  local env_file="$env_dir/${ZELLIJ_SESSION_NAME:-client}"
  [[ -f "$env_file" ]] || env_file="$env_dir/client"
  [[ -f "$env_file" ]] || return 0

  local -A st
  if zstat -H st -F "%s.%N" "$env_file" 2>/dev/null; then
    if [[ "$st[mtime]" == "$_zellij_client_env_mtime" ]]; then
      return 0
    fi
    _zellij_client_env_mtime="$st[mtime]"
  fi

  local k v
  while IFS='=' read -r k v; do
    case "$k" in
      SSH)
        _ZSH_CLIP_IS_SSH="$v"
        ;;
      SSH_AUTH_SOCK)
        if [[ -n "$v" ]]; then export SSH_AUTH_SOCK="$v"; else unset SSH_AUTH_SOCK; fi
        ;;
      SSH_CLIENT)
        if [[ -n "$v" ]]; then export SSH_CLIENT="$v"; else unset SSH_CLIENT; fi
        ;;
      SSH_CONNECTION)
        if [[ -n "$v" ]]; then export SSH_CONNECTION="$v"; else unset SSH_CONNECTION; fi
        ;;
      SSH_TTY)
        if [[ -n "$v" ]]; then export SSH_TTY="$v"; else unset SSH_TTY; fi
        ;;
      WAYLAND_DISPLAY)
        _ZSH_CLIP_WAYLAND="$v"
        if [[ -n "$v" ]]; then export WAYLAND_DISPLAY="$v"; else unset WAYLAND_DISPLAY; fi
        ;;
      DISPLAY)
        _ZSH_CLIP_DISPLAY="$v"
        if [[ -n "$v" ]]; then export DISPLAY="$v"; else unset DISPLAY; fi
        ;;
    esac
  done < "$env_file"
}

_zsh_resolve_clipboard_env() {
  if [[ -n "$ZELLIJ" ]]; then
    _zellij_sync_client_env_hook
  elif [[ -n "$SSH_CONNECTION" || -n "$SSH_CLIENT" || -n "$SSH_TTY" ]]; then
    _ZSH_CLIP_IS_SSH=1
    _ZSH_CLIP_WAYLAND=""
    _ZSH_CLIP_DISPLAY=""
  else
    _ZSH_CLIP_IS_SSH=0
    _ZSH_CLIP_WAYLAND="$WAYLAND_DISPLAY"
    _ZSH_CLIP_DISPLAY="$DISPLAY"
  fi
}

# Zsh Vi Mode Clipboard & OSC 52 Remote Copy
zsh_clipboard_copy() {
  local input b64 clip_dir clip_file
  input="$(cat; print -n x)"
  input="${input%x}"
  [[ -z "$input" ]] && return 0

  clip_dir="${XDG_CACHE_HOME:-$HOME/.cache}"
  [[ -d "$clip_dir" ]] || mkdir -p "$clip_dir" 2>/dev/null
  clip_file="$clip_dir/clipboard"
  printf "%s" "$input" > "$clip_file" 2>/dev/null

  if (( $+commands[base64] )); then
    b64=$(printf "%s" "$input" | base64 | tr -d '\r\n')
  fi

  if [[ -n "$b64" && -w /dev/tty ]]; then
    if [[ -n "$TMUX" ]]; then
      printf '\ePtmux;\e\e]52;c;%s\a\e\\' "$b64" > /dev/tty 2>/dev/null
    else
      printf '\e]52;c;%s\a' "$b64" > /dev/tty 2>/dev/null
    fi
  fi

  local _ZSH_CLIP_IS_SSH _ZSH_CLIP_WAYLAND _ZSH_CLIP_DISPLAY
  _zsh_resolve_clipboard_env

  if [[ "$_ZSH_CLIP_IS_SSH" != "1" ]]; then
    if [[ -n "$_ZSH_CLIP_WAYLAND" ]] && (( $+commands[wl-copy] )); then
      WAYLAND_DISPLAY="$_ZSH_CLIP_WAYLAND" printf "%s" "$input" | wl-copy >/dev/null 2>&1
    elif [[ -n "$_ZSH_CLIP_DISPLAY" ]] && (( $+commands[xclip] )); then
      DISPLAY="$_ZSH_CLIP_DISPLAY" printf "%s" "$input" | xclip -selection clipboard >/dev/null 2>&1
    elif [[ -n "$_ZSH_CLIP_DISPLAY" ]] && (( $+commands[xsel] )); then
      DISPLAY="$_ZSH_CLIP_DISPLAY" printf "%s" "$input" | xsel --clipboard -i >/dev/null 2>&1
    elif [[ "$OSTYPE" == "darwin"* ]] && (( $+commands[pbcopy] )); then
      printf "%s" "$input" | pbcopy >/dev/null 2>&1
    fi
  fi
  return 0
}

zsh_clipboard_paste() {
  local out clip_file="${XDG_CACHE_HOME:-$HOME/.cache}/clipboard"
  local _ZSH_CLIP_IS_SSH _ZSH_CLIP_WAYLAND _ZSH_CLIP_DISPLAY
  _zsh_resolve_clipboard_env

  if [[ "$_ZSH_CLIP_IS_SSH" != "1" ]]; then
    if [[ -n "$_ZSH_CLIP_WAYLAND" ]] && (( $+commands[wl-paste] )); then
      out=$(WAYLAND_DISPLAY="$_ZSH_CLIP_WAYLAND" wl-paste -n 2>/dev/null)
    elif [[ -n "$_ZSH_CLIP_DISPLAY" ]] && (( $+commands[xclip] )); then
      out=$(DISPLAY="$_ZSH_CLIP_DISPLAY" xclip -selection clipboard -o 2>/dev/null)
    elif [[ -n "$_ZSH_CLIP_DISPLAY" ]] && (( $+commands[xsel] )); then
      out=$(DISPLAY="$_ZSH_CLIP_DISPLAY" xsel --clipboard -o 2>/dev/null)
    elif [[ "$OSTYPE" == "darwin"* ]] && (( $+commands[pbpaste] )); then
      out=$(pbpaste 2>/dev/null)
    fi
  fi

  if [[ -n "$out" ]]; then
    printf "%s" "$out"
  elif [[ -f "$clip_file" ]]; then
    cat "$clip_file" 2>/dev/null
  fi
  return 0
}

