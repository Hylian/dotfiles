[build]
{{- if lookPath "sccache" }}
rustc-wrapper = {{ lookPath "sccache" | quote }}
{{- else if stat "/opt/homebrew/bin/sccache" }}
rustc-wrapper = "/opt/homebrew/bin/sccache"
{{- else if stat "/usr/bin/sccache" }}
rustc-wrapper = "/usr/bin/sccache"
{{- end }}
jobs = {{ output "getconf" "_NPROCESSORS_ONLN" | trim }}
incremental = false

